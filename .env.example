# Public — safe to expose to the browser (docs/06-security.md Section 14)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never prefix with NEXT_PUBLIC_, never import outside server code
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — HMAC key signing the admin session cookie (06-security.md
# Section 2.5). Distinct from any token_hash. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
ADMIN_SESSION_SECRET=
